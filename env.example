# =============================================================================
# frontline-clinical-rag environment template
# =============================================================================
# How to use:
#   1. Copy this file to `.env` in the project root.
#   2. Keep secrets only in `.env`; do not commit real API keys or private paths.
#   3. Values below mirror `src/frontline_clinical_rag/core/config.py` defaults.
#   4. Uncomment optional values only when you need to override the default.
#
# Notes:
#   - Relative paths are resolved from the project root.
#   - Boolean values can be `true` or `false`.
#   - List and dict values use JSON-style syntax.
# =============================================================================


# =============================================================================
# Application paths and chunking (`AppConfig`, `FRONTLINE_` prefix)
# =============================================================================

# Folder containing source PDFs and other raw clinical documents.
FRONTLINE_RAW_DATA_PATH=data/raw

# Optional project root override. Leave commented for normal local usage.
# FRONTLINE_PROJECT_ROOT=C:/Users/your-name/path/to/frontline-clinical-rag

# Full Merck Manual PDF path. The PDF is large and should remain gitignored.
FRONTLINE_MERCK_PDF_PATH=data/raw/Merk medical_diagnosis_manual-1-1999.pdf

# Chunking controls from ADR-002. Increase chunk size for more context, decrease
# it for more precise retrieval. Keep overlap below chunk size.
FRONTLINE_CHUNK_SIZE=800
FRONTLINE_CHUNK_OVERLAP=200
FRONTLINE_MAX_HEADING_LENGTH=140


# =============================================================================
# LLM provider (`LLMConfig`, `LLM_` prefix)
# =============================================================================

# Allowed: `local`, `xai`. Keep `local` for the default Ollama-style setup.
# xAI remains available in config, but it is not required for local usage.
LLM_PROVIDER=local
LLM_FALLBACK_PROVIDER=xai

# Local endpoint and model.
LLM_LOCAL_BASE_URL=http://localhost:11434
LLM_LOCAL_MODEL_NAME=llama3.1

# xAI endpoint, model, and API key. Leave the API key as a placeholder unless
# you intentionally enable the hosted fallback.
LLM_XAI_BASE_URL=https://api.x.ai/v1
LLM_XAI_MODEL_NAME=grok-3-mini
LLM_API_KEY=


# =============================================================================
# Optional local API compatibility (`OpenAIConfig`, `OPENAI_` prefix)
# =============================================================================

# These names exist because some LangChain clients use this prefix. The
# local-first setup does not require any cloud API key. Leave them commented
# unless you need to point a compatible client at a local proxy/server.
# OPENAI_API_KEY=not-needed-for-local
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_ORGANIZATION=


# =============================================================================
# Embeddings (`EmbeddingConfig`, `EMBEDDING_` prefix)
# =============================================================================

# Keep local for the default private embedding setup.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=100

# Local embedding device. Use `cpu` for portability, `cuda` for NVIDIA GPUs,
# or `mps` for Apple Silicon.
EMBEDDING_DEVICE=cpu


# =============================================================================
# Vector store (`VectorStoreConfig`, `VECTOR_STORE_` prefix)
# =============================================================================

# Allowed backends: `faiss`, `chroma`, `weaviate`.
VECTOR_STORE_BACKEND=faiss
VECTOR_STORE_PATH=data/vector_store/faiss_index
VECTOR_STORE_COLLECTION_NAME=merck_manual_clinical
VECTOR_STORE_DISTANCE_METRIC=cosine


# =============================================================================
# Retrieval / hybrid retrieval (`RetrievalConfig`, `RETRIEVER_` prefix)
# =============================================================================

# Allowed strategies: `hierarchical`, `recursive`.
RETRIEVER_STRATEGY=hierarchical

# Final, dense, and sparse result counts. Keep dense/sparse >= final top-k.
RETRIEVER_K_FINAL=5
RETRIEVER_K_DENSE=8
RETRIEVER_K_SPARSE=8

# Hybrid retrieval combines dense vector search, sparse BM25, RRF, and metadata
# boosts. Disable only for debugging or strategy comparison.
RETRIEVER_USE_HYBRID=true
RETRIEVER_FORCE_REBUILD_INDEX=false
RETRIEVER_RRF_K=60

# Metadata-aware boosts from ADR-004. Warnings are intentionally boosted because
# safety-critical passages should rank higher for clinical questions.
RETRIEVER_METADATA_BOOSTING={"section_hierarchy":1.2,"has_warning":1.5,"page_range_boost":1.0,"warning":1.7,"table":1.25}
RETRIEVER_SAFETY_WARNING_LEVELS=["black_box","boxed_warning"]
RETRIEVER_SAFETY_QUERY_TERMS=["warning","contraindication","black box","adverse","risk","toxicity"]
RETRIEVER_SAFETY_DOWNWEIGHT_FACTOR=0.55
RETRIEVER_CHUNK_OVERLAP_FOR_CONTEXT=200


# =============================================================================
# Clinical safety (`SafetyConfig`, `SAFETY_` prefix)
# =============================================================================

SAFETY_REQUIRE_CITATION=true
SAFETY_MAX_CONTEXT_TOKENS=8000
SAFETY_ENABLE_REFUSAL=true

# Raise to 0.65-0.75 after collecting real usage traces for tighter escalation.
SAFETY_LOW_CONFIDENCE_THRESHOLD=0.5

# Keep this explicit so local demos and generated responses use the same wording.
SAFETY_MEDICAL_DISCLAIMER=This is an AI-assisted decision support tool. All information must be verified against primary sources and clinical judgment. Not a substitute for professional medical advice.


# =============================================================================
# Deterministic evaluation (`EvaluationConfig`, `EVALUATION_` prefix)
# =============================================================================

# Run modes: `metric_unit`, `harness_integration`, `live_eval`.
EVALUATION_RUN_MODE=metric_unit
EVALUATION_DETERMINISTIC=true
EVALUATION_MIN_SOURCES=1
EVALUATION_STRATEGIES=["hierarchical"]

# When using the root `AppConfig`, these evaluation values are derived from the
# safety and retrieval sections above to keep one source of truth:
#   - low confidence threshold <- SAFETY_LOW_CONFIDENCE_THRESHOLD
#   - top-k                    <- RETRIEVER_K_FINAL
#   - high warning levels      <- RETRIEVER_SAFETY_WARNING_LEVELS